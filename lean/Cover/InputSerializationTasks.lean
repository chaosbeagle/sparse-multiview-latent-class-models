import Cover.InputTasks

namespace Cover.InputTasks
open Cover.FinTask

/-- Enumerating finite index values is stepped; lookup of one given finite-array entry is a primitive. -/
theorem map_finRange_eq_ofFn {n : ℕ} {α : Type} (f : Fin n → α) :
    (List.finRange n).map f = List.ofFn f := by
  rw [← List.ofFn_id,List.map_ofFn]
  rfl

/-- Sorted edge indices are generated by an ordered finite scan, avoiding opaque Finset sorting. -/
def edgeIndicesTask {g : ℕ} (e : Finset (Fin g)) : FinTask (List (Fin g)) := do
  let all ← finRangeTask g
  filterTask (fun i => decide (i ∈ e)) all

theorem edgeIndicesTask_result {g : ℕ} (e : Finset (Fin g)) :
    (edgeIndicesTask e).result = e.sort (· ≤ ·) := by
  simp only [edgeIndicesTask,FinTask.result_bindM,finRangeTask_result,filterTask_result]
  let xs := (List.finRange g).filter (fun i => decide (i ∈ e))
  have hn : xs.Nodup := (List.nodup_finRange g).filter _
  have hp : xs.Pairwise (· ≤ ·) :=
    ((List.pairwise_lt_finRange g).imp (fun h => le_of_lt h)).filter _
  have hs : xs.toFinset = e := by ext i; simp [xs]
  have he := (List.toFinset_sort (· ≤ ·) hn).mpr hp
  rw [hs] at he
  exact he.symm

def writeBlockTask (xs : List ℕ) : FinTask (List ℕ) := do
  let n ← lengthTask xs
  primitive (fun _ => n::xs)
@[simp] theorem writeBlockTask_result (xs : List ℕ) :
    (writeBlockTask xs).result = DesignCodec.writeBlock xs := by
  simp [writeBlockTask,DesignCodec.writeBlock]

def writeEdgeTask {g : ℕ} (e : Finset (Fin g)) : FinTask (List ℕ) := do
  let indices ← edgeIndicesTask e
  let tokens ← mapTask (fun i => primitive (fun _ => i.val)) indices
  writeBlockTask tokens
@[simp] theorem writeEdgeTask_result {g : ℕ} (e : Finset (Fin g)) :
    (writeEdgeTask e).result = DesignCodec.writeEdge e := by
  simp [writeEdgeTask,edgeIndicesTask_result,DesignCodec.writeEdge]

def serializeDesignTask (I : FiniteDesign.Syntax) : FinTask (List ℕ) := .step fun _ => do
  let groups ← finRangeTask I.groups
  let ns ← mapTask (fun i => primitive (fun _ => I.outputPred i)) groups
  let outputs ← writeBlockTask ns
  let edges ← flatMapTask writeEdgeTask I.edges
  let edgeCount ← lengthTask I.edges
  let suffix ← primitive (fun _ => edgeCount::edges)
  let body ← appendTask outputs suffix
  primitive (fun _ => 1::I.groups::I.rankPred::body)

theorem serializeDesignTask_result (I : FiniteDesign.Syntax) :
    (serializeDesignTask I).result = DesignCodec.serialize I := by
  simp [serializeDesignTask,map_finRange_eq_ofFn,DesignCodec.serialize,DesignCodec.writeEdges]

/-- Entire exact input framing/serialization runs through stepped list traversals and scalar codecs. -/
def serializeInputTask (I : A06.Input) : FinTask (List ℕ) := do
  let design ← serializeDesignTask I.design
  let weight ← AlgCodec.serializeTask I.weight
  let sigma ← AlgCodec.serializeTask I.sigma
  let d ← writeBlockTask design
  let w ← writeBlockTask weight
  let s ← writeBlockTask sigma
  let dw ← appendTask d w
  let body ← appendTask dw s
  primitive (fun _ => 1::body)

theorem serializeInputTask_result (I : A06.Input) :
    (serializeInputTask I).result = A06InputCodec.serialize I := by
  simp [serializeInputTask,serializeDesignTask_result,AlgCodec.serializeTask_result,A06InputCodec.serialize]
end Cover.InputTasks
